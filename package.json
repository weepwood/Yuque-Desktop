{
  "name": "yuque-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, local-first Yuque desktop client",
  "main": "./out/main/index.js",
  "author": "WEEPWOOD",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0",
    "dompurify": "^3.2.6",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.22"
  },
  "build": {
    "appId": "dev.weepwood.yuque",
    "productName": "Yuque Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
